# SheetSnap — optional configuration.
#
# NONE of these are required. The app runs out of the box with sensible
# defaults (ffmpeg is bundled, data lives in ./data, uploads up to 2 GB).
# Copy this file to `.env` and uncomment only what you need.

# Where job history + artifacts are stored. In packaged desktop builds this
# is set automatically to the OS user-data folder; override it only if you
# want a custom location during local development.
# SHEETSNAP_DATA_DIR=/path/to/data

# Override the bundled ffmpeg binary (ffmpeg-static ships one per platform,
# so you normally don't need this).
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe

# Path to yt-dlp for the YouTube source step. The desktop installer bundles
# it automatically; for local development point this at a yt-dlp download:
# https://github.com/yt-dlp/yt-dlp/releases
# YTDLP_PATH=C:\tools\yt-dlp.exe

# Upload size cap in megabytes (default 2048 = 2 GB).
# MAX_UPLOAD_MB=2048
